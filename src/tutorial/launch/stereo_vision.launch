<launch>
    <!--
      Stereo Vision Launch File for Simulator
      This launch file is configured for cameras that are already publishing topics,
      for example, from a simulator like Gazebo or a pre-recorded bag file.

      Usage:
      1. Install necessary packages:
         sudo apt-get install ros-noetic-stereo-image-proc ros-noetic-camera-info-publisher
      2. Make sure your simulator is running and publishing images on the topics specified in the 'remap' tags below.
      3. After running a real calibration, update the config/left.yaml and config/right.yaml files.
      4. Run the launch file: roslaunch tutorial stereo_vision.launch
    -->

    <!-- Group all nodes under the 'stereo' namespace -->
    <group ns="stereo">

        <!-- 
          These nodes publish the camera calibration data. 
          They read the .yaml files and publish the corresponding CameraInfo messages.
        -->
        <node pkg="camera_info_publisher" type="camera_info_publisher" name="left_camera_info_publisher">
            <param name="camera_info_url" value="package://tutorial/config/left.yaml" />
            <param name="frame_id" value="left_camera_optical_frame" />
            <remap from="/camera_info" to="/stereo/left/camera_info" />
        </node>

        <node pkg="camera_info_publisher" type="camera_info_publisher" name="right_camera_info_publisher">
            <param name="camera_info_url" value="package://tutorial/config/right.yaml" />
            <param name="frame_id" value="right_camera_optical_frame" />
            <remap from="/camera_info" to="/stereo/right/camera_info" />
        </node>

        <!-- 
          The main stereo processing node.
          It subscribes to the raw image topics from your simulator and the CameraInfo topics
          from the publishers above. It then publishes rectified images, disparity, and point clouds.
        -->
        <node pkg="stereo_image_proc" type="stereo_image_proc" name="stereo_image_proc">
            <!-- Remap the input image topics to your simulator's topics -->
            <remap from="/stereo/left/image_raw" to="/fsds/cameracam1" />
            <remap from="/stereo/right/image_raw" to="/fsds/cameracam2" />
        </node>

    </group>

    <!-- Optional: Launch RViz for visualization with a pre-made config -->
    <node pkg="rviz" type="rviz" name="rviz" args="-d $(find tutorial)/launch/stereo_vision.rviz" />

</launch>